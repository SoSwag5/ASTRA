     "host": "careers.zu.ac.ae"
    },
    {
     "id": "zu-dns-jobs",
     "kind": "dns",
     "host": "jobs.zu.ac.ae"
    },
    {
     "id": "zu-tls",
     "kind": "tls",
     "host": "www.zu.ac.ae",
     "read_presented_certificate": false
    },
    {
     "id": "zu-careers",
     "kind": "page",
